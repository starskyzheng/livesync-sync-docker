# Self-hosted LiveSync CLI — Environment Variables
#
# Auto-configuration: 首次运行时，从环境变量生成 settings.json。
# 已有 settings.json 时，环境变量被忽略，自动加载现有配置。

# ═══════════════════════════════════════════════════════════════════════════
# CouchDB 配置（首次运行必须）
# ═══════════════════════════════════════════════════════════════════════════

# CouchDB 服务地址（必需）
COUCHDB_URL=http://couchdb:5984

# 认证（可选，取决于你的 CouchDB 配置）
# COUCHDB_USER=admin
# COUCHDB_PASSWORD=your-password

# 数据库名（可选，默认 obsidian-livesync）
# COUCHDB_DBNAME=obsidian-livesync

# ═══════════════════════════════════════════════════════════════════════════
# 加密（可选）
# ═══════════════════════════════════════════════════════════════════════════

# ENCRYPT=true
# ENCRYPT_PASSPHRASE=your-passphrase

# ═══════════════════════════════════════════════════════════════════════════
# Obsidian Setup URI（可选，优先级高于 COUCHDB_* 变量）
# 从 Obsidian LiveSync 插件导出的 URI，一键配置所有设置
# ═══════════════════════════════════════════════════════════════════════════

# SETUP_URI=obsidian://setuplivesync?settings=...

# ═══════════════════════════════════════════════════════════════════════════
# 路径覆盖
# ═══════════════════════════════════════════════════════════════════════════

# LIVESYNC_DB_PATH=/data

# ═══════════════════════════════════════════════════════════════════════════
# 同步设置
# ═══════════════════════════════════════════════════════════════════════════

# 是否启用 LiveSync（默认 true）
# LIVESYNC_ENABLE=true

# 保存时同步（默认 true）
# SYNC_ON_SAVE=true

# 启动时同步（默认 true）
# SYNC_ON_START=true
